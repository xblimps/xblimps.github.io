# ---- Client (safe to expose; bundled into the SPA) ----
# Without these the app runs in local demo mode. With them, it requires login.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Server only (Vercel env var, NEVER prefixed with VITE_, never committed) ----
# Used by /api/invite to send magic-link invite emails and provision access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: defaults to VITE_SUPABASE_URL if unset
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# ---- HuggingFace backup (server only — used by /api/hf-sync and `npm run hf:sync`) ----
# A write token for the xBLiMPs org. Takes precedence over the hardcoded fallback in
# scripts/hf/hub.mjs. STRONGLY recommended: set this and rotate the hardcoded fallback.
# Create at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your-write-token
# Optional: override the target org (default: xBLiMPs)
# HF_ORG=xBLiMPs
